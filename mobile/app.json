{
  "expo": {
    "name": "NORYX",
    "slug": "noryx",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "noryx",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "be.noryx.app"
    },
    "android": {
      "package": "be.noryx.app",
      "adaptiveIcon": {
        "backgroundColor": "#fbf8f5",
        "foregroundImage": "./assets/images/android-icon-foreground.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "plugins": [
      "expo-router",
      "expo-font",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/noryx-symbol.png",
          "imageWidth": 160,
          "resizeMode": "contain",
          "backgroundColor": "#fbf8f5"
        }
      ],
      "expo-localization",
      "expo-secure-store"
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
