# ─────────────────────────────────────────────────────────────────────────────
# NORYX environment variables — copy to .env.local and fill in real values.
# Never commit real credentials. Only variables prefixed NEXT_PUBLIC_ are sent
# to the browser; everything else stays on the server.
# ─────────────────────────────────────────────────────────────────────────────

# Public base URL of this deployment (used for auth redirects and absolute links).
# On Vercel, leave it unset to use the deployment's own URL, or set it to your
# domain (https://...). A localhost value is ignored on Vercel.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Supabase project — Dashboard → Project Settings → API Keys.
# Create the project in an EU region (e.g. Frankfurt) for European customer data.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
# Publishable key (sb_publishable_…). The legacy "anon" key also works.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_replace_me

# Secret key (sb_secret_…), or the legacy "service_role" key. SERVER ONLY.
# Bypasses row-level security — used only for privileged server tasks.
SUPABASE_SECRET_KEY=sb_secret_replace_me

# Anthropic API key for the AI assistant on the public website (console.anthropic.com). SERVER ONLY.
# Leave empty to run the assistant in search-only mode (answers from the FAQ and help centre).
ANTHROPIC_API_KEY=
